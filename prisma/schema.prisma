generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitType {
  QUANTITY
  WEIGHT
  VOLUME
  OTHER
}
enum SaleStatus {
  COMPLETED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
  CREDIT_PENDING
  CREDIT_PAID
}
enum PaymentMethod {
  CASH
  YAPE
  PLIN
  CARD
  TRANSFER
  CREDIT
  OTHER
}
enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  LOSS
  DAMAGE
  EXPIRATION
  INTERNAL_USE
  CANCELLATION
  INITIAL_STOCK
  IMPORT
}
enum CashMovementType {
  SALE
  CREDIT_PAYMENT
  EXPENSE
  WITHDRAWAL
  DEPOSIT
  REFUND
  ADJUSTMENT
}
enum CashSessionStatus {
  OPEN
  CLOSED
}
enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}
enum ImportStatus {
  PENDING
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}
enum ImportType {
  CREATE
  UPDATE
  UPSERT
}
enum CreditMovementType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  CANCELLATION
}
enum StockCountStatus {
  DRAFT
  COUNTING
  PENDING_APPROVAL
  APPROVED
  CANCELLED
}
enum PromotionType {
  SPECIAL_PRICE
  PERCENTAGE
  FIXED
  TWO_FOR_ONE
  MINIMUM_QUANTITY
}
enum ExpenseStatus {
  ACTIVE
  CANCELLED
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  imageUrl           String?
  imagePublicId      String?
  active             Boolean             @default(true)
  emailVerifiedAt    DateTime?
  failedLoginCount   Int                 @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  roles              UserRole[]
  sessions           Session[]
  emailTokens        EmailVerificationToken[]
  resetTokens        PasswordResetToken[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]
  priceHistory       ProductPriceHistory[]
  sales              Sale[]
  purchases          Purchase[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  creditMovements    CreditMovement[]
  importJobs         ImportJob[]
  expenses           Expense[]
  stockCounts        StockCount[]

  @@index([active, deletedAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  system      Boolean          @default(false)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  description String?
  roles       RolePermission[]

  @@index([module])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model ProductCategory {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  description   String?
  parentId      String?
  imageUrl      String?
  imagePublicId String?
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  parent        ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children      ProductCategory[] @relation("CategoryTree")
  products      Product[]
  @@unique([parentId, name])
  @@index([active, deletedAt])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  products  Product[]
}

model UnitOfMeasure {
  id             String                  @id @default(cuid())
  name           String                  @unique
  symbol         String                  @unique
  type           UnitType
  allowsDecimals Boolean                 @default(false)
  active         Boolean                 @default(true)
  products       Product[]
  fromConversions ProductUnitConversion[] @relation("FromUnit")
  toConversions   ProductUnitConversion[] @relation("ToUnit")
}

model Product {
  id                  String                  @id @default(cuid())
  sku                 String                  @unique
  name                String
  shortName           String?
  description         String?
  categoryId          String?
  subcategory         String?
  brandId             String?
  unitOfMeasureId     String
  saleType            UnitType               @default(QUANTITY)
  qrCode              String?                 @unique
  purchasePrice       Decimal                 @default(0) @db.Decimal(14, 4)
  averageCost         Decimal                 @default(0) @db.Decimal(14, 4)
  lastCost            Decimal                 @default(0) @db.Decimal(14, 4)
  salePrice           Decimal                 @db.Decimal(14, 4)
  wholesalePrice      Decimal?                @db.Decimal(14, 4)
  promotionalPrice    Decimal?                @db.Decimal(14, 4)
  stock               Decimal                 @default(0) @db.Decimal(18, 4)
  minimumStock        Decimal                 @default(0) @db.Decimal(18, 4)
  maximumStock        Decimal?                @db.Decimal(18, 4)
  defaultSupplierId   String?
  imageUrl            String?
  imagePublicId       String?
  allowsDecimals      Boolean                 @default(false)
  allowsDiscount      Boolean                 @default(true)
  allowsNegativeStock Boolean                 @default(false)
  tracksExpiration    Boolean                 @default(false)
  active              Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  deletedAt           DateTime?
  category            ProductCategory?        @relation(fields: [categoryId], references: [id])
  brand               Brand?                  @relation(fields: [brandId], references: [id])
  unitOfMeasure       UnitOfMeasure           @relation(fields: [unitOfMeasureId], references: [id])
  defaultSupplier     Supplier?               @relation(fields: [defaultSupplierId], references: [id])
  barcodes            ProductBarcode[]
  conversions         ProductUnitConversion[]
  priceHistory        ProductPriceHistory[]
  batches             ProductBatch[]
  inventoryMovements  InventoryMovement[]
  purchaseItems       PurchaseItem[]
  saleItems           SaleItem[]
  stockCountItems     StockCountItem[]
  promotionProducts   PromotionProduct[]
  refundItems         SaleRefundItem[]
  @@index([name])
  @@index([categoryId, active])
  @@index([brandId])
  @@index([stock, minimumStock])
  @@index([deletedAt])
}

model ProductBarcode {
  id        String  @id @default(cuid())
  productId String
  code      String  @unique
  type      String
  primary   Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model ProductUnitConversion {
  id          String        @id @default(cuid())
  productId   String
  fromUnitId  String
  toUnitId    String
  factor      Decimal       @db.Decimal(18, 6)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUnit    UnitOfMeasure @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit      UnitOfMeasure @relation("ToUnit", fields: [toUnitId], references: [id])
  @@unique([productId, fromUnitId, toUnitId])
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  oldPrice  Decimal  @db.Decimal(14, 4)
  newPrice  Decimal  @db.Decimal(14, 4)
  reason    String?
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@index([productId, createdAt])
}

model ProductBatch {
  id          String   @id @default(cuid())
  productId   String
  batchNumber String
  quantity    Decimal  @db.Decimal(18, 4)
  cost        Decimal  @db.Decimal(14, 4)
  receivedAt  DateTime
  expiresAt   DateTime?
  product     Product  @relation(fields: [productId], references: [id])
  @@unique([productId, batchNumber])
  @@index([expiresAt])
}

model Supplier {
  id             String    @id @default(cuid())
  ruc            String?   @unique
  legalName      String
  tradeName      String?
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  defaultProducts Product[]
  purchases      Purchase[]
}

model Purchase {
  id            String         @id @default(cuid())
  code          String         @unique
  supplierId    String
  purchasedAt   DateTime
  documentType  String?
  series        String?
  documentNumber String?
  subtotal      Decimal        @db.Decimal(14, 2)
  discount      Decimal        @default(0) @db.Decimal(14, 2)
  tax           Decimal        @default(0) @db.Decimal(14, 2)
  total         Decimal        @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  credit        Boolean        @default(false)
  status        PurchaseStatus @default(DRAFT)
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  items         PurchaseItem[]
  @@index([supplierId, purchasedAt])
  @@index([status])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Decimal  @db.Decimal(18, 4)
  unitCost   Decimal  @db.Decimal(14, 4)
  discount   Decimal  @default(0) @db.Decimal(14, 2)
  subtotal   Decimal  @db.Decimal(14, 2)
  batchNumber String?
  expiresAt  DateTime?
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  @@index([productId])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  previousStock Decimal               @db.Decimal(18, 4)
  quantity      Decimal               @db.Decimal(18, 4)
  resultingStock Decimal              @db.Decimal(18, 4)
  unitCost      Decimal?              @db.Decimal(14, 4)
  type          InventoryMovementType
  referenceType String?
  referenceId   String?
  reason        String?
  userId        String
  createdAt     DateTime              @default(now())
  product       Product               @relation(fields: [productId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
}

model StockCount {
  id        String           @id @default(cuid())
  code      String           @unique
  status    StockCountStatus @default(DRAFT)
  notes     String?
  userId    String
  createdAt DateTime         @default(now())
  approvedAt DateTime?
  user      User             @relation(fields: [userId], references: [id])
  items     StockCountItem[]
}

model StockCountItem {
  id          String     @id @default(cuid())
  stockCountId String
  productId   String
  systemStock Decimal    @db.Decimal(18, 4)
  physicalStock Decimal? @db.Decimal(18, 4)
  difference  Decimal?   @db.Decimal(18, 4)
  stockCount  StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id])
  @@unique([stockCountId, productId])
}

model Customer {
  id          String    @id @default(cuid())
  dni         String?   @unique
  ruc         String?   @unique
  firstName   String?
  lastName    String?
  legalName   String?
  phone       String?
  email       String?
  address     String?
  birthDate   DateTime?
  creditLimit Decimal   @default(0) @db.Decimal(14, 2)
  notes       String?
  general     Boolean   @default(false)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  sales       Sale[]
  credit      CustomerCredit?
  @@index([firstName, lastName])
  @@index([active, deletedAt])
}

model CustomerCredit {
  id          String           @id @default(cuid())
  customerId  String           @unique
  balance     Decimal          @default(0) @db.Decimal(14, 2)
  updatedAt   DateTime         @updatedAt
  customer    Customer         @relation(fields: [customerId], references: [id])
  movements   CreditMovement[]
  payments    CreditPayment[]
}

model CreditMovement {
  id          String             @id @default(cuid())
  creditId    String
  type        CreditMovementType
  amount      Decimal            @db.Decimal(14, 2)
  balanceAfter Decimal           @db.Decimal(14, 2)
  referenceType String?
  referenceId String?
  notes       String?
  userId      String
  createdAt   DateTime           @default(now())
  credit      CustomerCredit     @relation(fields: [creditId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  @@index([creditId, createdAt])
}

model CreditPayment {
  id            String         @id @default(cuid())
  creditId      String
  amount        Decimal        @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  reference     String?
  cashSessionId String?
  createdAt     DateTime       @default(now())
  credit        CustomerCredit @relation(fields: [creditId], references: [id])
  cashSession   CashSession?   @relation(fields: [cashSessionId], references: [id])
}

model Sale {
  id              String       @id @default(cuid())
  code            String       @unique
  customerId      String
  userId          String
  cashSessionId   String
  subtotal        Decimal      @db.Decimal(14, 2)
  discount        Decimal      @default(0) @db.Decimal(14, 2)
  tax             Decimal      @default(0) @db.Decimal(14, 2)
  total           Decimal      @db.Decimal(14, 2)
  paidAmount      Decimal      @default(0) @db.Decimal(14, 2)
  creditAmount    Decimal      @default(0) @db.Decimal(14, 2)
  status          SaleStatus   @default(COMPLETED)
  idempotencyKey  String       @unique
  cancelledAt     DateTime?
  cancellationReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  customer        Customer     @relation(fields: [customerId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  cashSession     CashSession  @relation(fields: [cashSessionId], references: [id])
  items           SaleItem[]
  payments        SalePayment[]
  refunds         SaleRefund[]
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  productId    String
  quantity     Decimal  @db.Decimal(18, 4)
  unitPrice    Decimal  @db.Decimal(14, 4)
  unitCost     Decimal  @db.Decimal(14, 4)
  discount     Decimal  @default(0) @db.Decimal(14, 2)
  subtotal     Decimal  @db.Decimal(14, 2)
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])
  refundItems  SaleRefundItem[]
  @@index([productId])
}

model SalePayment {
  id            String        @id @default(cuid())
  saleId        String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(14, 2)
  receivedAmount Decimal?     @db.Decimal(14, 2)
  changeAmount  Decimal?      @db.Decimal(14, 2)
  reference     String?
  operationCode String?
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  @@index([method])
}

model SaleRefund {
  id          String           @id @default(cuid())
  code        String           @unique
  saleId      String
  amount      Decimal          @db.Decimal(14, 2)
  reason      String
  returnsStock Boolean         @default(true)
  createdAt   DateTime         @default(now())
  sale        Sale             @relation(fields: [saleId], references: [id])
  items       SaleRefundItem[]
}

model SaleRefundItem {
  id          String     @id @default(cuid())
  refundId    String
  saleItemId  String
  productId   String
  quantity    Decimal    @db.Decimal(18, 4)
  amount      Decimal    @db.Decimal(14, 2)
  refund      SaleRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItem    SaleItem   @relation(fields: [saleItemId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])
}

model CashRegister {
  id        String        @id @default(cuid())
  name      String        @unique
  active    Boolean       @default(true)
  sessions  CashSession[]
}

model CashSession {
  id             String            @id @default(cuid())
  cashRegisterId String
  userId         String
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @db.Decimal(14, 2)
  expectedAmount Decimal?          @db.Decimal(14, 2)
  countedAmount  Decimal?          @db.Decimal(14, 2)
  difference     Decimal?          @db.Decimal(14, 2)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  cashRegister   CashRegister      @relation(fields: [cashRegisterId], references: [id])
  user           User              @relation(fields: [userId], references: [id])
  sales          Sale[]
  movements      CashMovement[]
  creditPayments CreditPayment[]
  expenses       Expense[]
  @@index([userId, status])
  @@index([cashRegisterId, status])
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  type          CashMovementType
  amount        Decimal          @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  referenceType String?
  referenceId   String?
  description   String?
  userId        String
  createdAt     DateTime         @default(now())
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  @@index([cashSessionId, createdAt])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  active   Boolean   @default(true)
  expenses Expense[]
}

model Expense {
  id            String         @id @default(cuid())
  code          String         @unique
  categoryId    String
  description   String
  amount        Decimal        @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  cashSessionId String?
  userId        String
  status        ExpenseStatus  @default(ACTIVE)
  createdAt     DateTime       @default(now())
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  cashSession   CashSession?   @relation(fields: [cashSessionId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
}

model Promotion {
  id        String             @id @default(cuid())
  name      String
  type      PromotionType
  value     Decimal            @db.Decimal(14, 4)
  minQuantity Decimal?         @db.Decimal(18, 4)
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean            @default(true)
  products  PromotionProduct[]
  @@index([active, startsAt, endsAt])
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([promotionId, productId])
}

model ImportJob {
  id            String       @id @default(cuid())
  code          String       @unique
  userId        String
  fileName      String
  type          ImportType
  status        ImportStatus @default(PENDING)
  totalRows     Int          @default(0)
  processedRows Int          @default(0)
  createdRows   Int          @default(0)
  updatedRows   Int          @default(0)
  skippedRows   Int          @default(0)
  errorRows     Int          @default(0)
  mapping       Json?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  user          User         @relation(fields: [userId], references: [id])
  errors        ImportError[]
  @@index([createdAt])
}

model ImportError {
  id        String    @id @default(cuid())
  importJobId String
  rowNumber Int
  field     String?
  value     String?
  message   String
  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  @@index([importJobId, rowNumber])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  module       String
  resource     String
  resourceId   String?
  ip           String?
  userAgent    String?
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
  @@index([module, createdAt])
  @@index([resource, resourceId])
  @@index([userId, createdAt])
}

model BusinessSettings {
  id                    String   @id @default("singleton")
  businessName          String   @default("MINIMARKET DON LUCHO")
  ruc                   String?
  address               String?
  phone                 String?
  logoUrl               String?
  logoPublicId          String?
  currency              String   @default("PEN")
  skuPrefix             String   @default("DL")
  salePrefix            String   @default("V")
  taxRate               Decimal  @default(18) @db.Decimal(5, 2)
  defaultMinimumStock   Decimal  @default(5) @db.Decimal(18, 4)
  expirationAlertDays   Int      @default(30)
  ticketWidth           Int      @default(80)
  requireDigitalReference Boolean @default(false)
  updatedAt             DateTime @updatedAt
}

model Sequence {
  key       String   @id
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt
}
